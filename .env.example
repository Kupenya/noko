DB_HOST=localhost
DB_PORT=5432
DB_NAME=wedding
DB_USER=postgres
DB_PASSWORD=

# Used to sign the admin session cookie; use a long random value
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Optional Gmail RSVP notifications
SMTP_USER=
SMTP_FROM=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Controlled admin account creation
ADMIN_SIGNUP_CODE=choose-a-private-signup-code
APP_URL=http://localhost:3001

# Persistent Cloudinary media storage (optional locally, recommended for Vercel)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=wedding-site
